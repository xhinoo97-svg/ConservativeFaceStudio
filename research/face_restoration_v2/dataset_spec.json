{
  "schema_version": 1,
  "dataset_id": "cfs-face-restoration-v2",
  "v1_baseline_sha": "2767513f95dde2d417e7c6f1faf2357149a1a32f",
  "private_user_photos_allowed": false,
  "identity_disjoint_splits": true,
